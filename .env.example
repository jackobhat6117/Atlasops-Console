# AtlasOps environment variables.
# Copy to .env.local to override locally (.env.local is gitignored).
# No secrets are needed: the API is a mock that runs in the browser.

# Probability (0–1) that a mock API request fails with a 500, to exercise error and retry states.
# Default: 0.05. Set to 0 for a failure-free demo.
VITE_MOCK_FAILURE_RATE=0.05
